# Copy this file to "secrets.yaml" and fill in YOUR values.
# secrets.yaml is listed in .gitignore and must NEVER be committed.
wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"
ap_password: "choose-a-fallback-hotspot-password"
# Generate a key with:  openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"
# MQTT broker for open data (delete the mqtt: block in the YAML if you do not use MQTT)
mqtt_broker: "192.168.1.10"
mqtt_user: "your-mqtt-user"
mqtt_password: "your-mqtt-password"
