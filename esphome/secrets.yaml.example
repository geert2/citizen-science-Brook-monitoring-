# 1. Copy this file to 'esphome/secrets.yaml' and replace the placeholder values.
# 2. Run 'esphome/sync-secrets.sh' (or copy the file by hand) so that a copy sits in
#    esphome/nodes/ and esphome/gateway/ - ESPHome only reads secrets.yaml from the
#    folder of the config it is building.
# Never commit your real secrets.yaml to GitHub (it is in .gitignore).

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"
ap_password: "ChangeMeFallbackAP"   # fallback hotspot of the gateway if Wi-Fi is lost

# Shared LoRa passphrase. Any strong random string works, e.g. `openssl rand -base64 32`.
# The gateway and ALL field nodes must use exactly the same value.
lora_encryption_key: "REPLACE_WITH_A_LONG_RANDOM_PASSPHRASE"
# Home Assistant API key (also used to encrypt over-the-air firmware updates): must be a 32-byte Base64 string (`openssl rand -base64 32`).
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY_HERE=="

# --- Station 1 (the brook) ---
# Height of the TL-136 pressure port above the ZERO of the staff gauge, in m (negative if below).
# Measure it at installation (docs/field-guide.md, section 4). It can be changed later from
# Home Assistant (entity "Brook Sensor Height Above Gauge Zero") without reflashing.
station_1_sensor_height_m: "0.05"
station_1_osem_box_id: "STATION_1_SENSEBOX_ID"
station_1_osem_token: "STATION_1_ACCESS_TOKEN"
station_1_osem_level_id: "STATION_1_WATER_LEVEL_SENSOR_ID"
station_1_osem_water_temp_id: "STATION_1_WATER_TEMP_SENSOR_ID"
station_1_osem_ec_id: "STATION_1_EC_SENSOR_ID"
station_1_osem_air_temp_id: "STATION_1_AIR_TEMP_SENSOR_ID"
station_1_osem_air_hum_id: "STATION_1_AIR_HUMIDITY_SENSOR_ID"
station_1_osem_pressure_id: "STATION_1_AIR_PRESSURE_SENSOR_ID"
